# ==================================================
# CareerForge AI - Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ==================================================

# ── MongoDB Atlas ────────────────────────────────────
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@careerforge-ai.ckdkxax.mongodb.net/careerforge-ai?retryWrites=true&w=majority&appName=careerforge-ai
MONGODB_DB_NAME=careerforge-ai

# ── JWT Security ─────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# ── n8n ─────────────────────────────────────────────
N8N_ENCRYPTION_KEY=changeme_generate_with_openssl_rand_hex_32
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_admin_password
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# ── OpenRouter ───────────────────────────────────────
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Recommended Ultra-Low-Cost High-Intelligence Models:
# - google/gemini-2.5-flash ($0.075/1M - 15,000+ jobs per $3) [DEFAULT]
# - meta-llama/llama-3.3-70b-instruct ($0.12/1M)
# - deepseek/deepseek-chat ($0.14/1M)
# - openai/gpt-4o-mini ($0.15/1M)
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Telegram (Optional for phone notifications) ─────
# Create bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Email Auto-Apply SMTP (Optional for automated emails) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=your_email@gmail.com

# ── Application Settings ─────────────────────────────
MAX_AI_REQUESTS_PER_DAY=50
MIN_MATCH_SCORE=70
PREFERRED_MATCH_SCORE=80
JOB_DESCRIPTION_MAX_CHARS=6000
ENABLE_MOCK_MODE=false

# ── Dashboard & Security ─────────────────────────────
DASHBOARD_PORT=3000
DASHBOARD_SECRET=changeme_dashboard_secret
DASHBOARD_PASSCODE=Ghaith_Master_Key_2026!

# ── Timezone ─────────────────────────────────────────
TZ=Africa/Tunis

# ── Admin & Security (WS3 / WS2) ─────────────────────
# Secret header value for POST /api/admin/promote to elevate users to Pro
ADMIN_SECRET=changeme_generate_with_openssl_rand_hex_32

# HMAC secret shared with the self-hosted LinkedIn auto-apply worker (Mode B)
# Must match WEBHOOK_HMAC_SECRET in the worker's config
WEBHOOK_HMAC_SECRET=changeme_generate_with_openssl_rand_hex_32

# ── Redis (BullMQ queue for LinkedIn Mode B worker) ───
# Local: redis://localhost:6379 | Docker Compose: redis://redis:6379
REDIS_URL=redis://localhost:6379
