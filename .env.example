# ==================================================
# CareerForge AI - Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ==================================================

# ── PostgreSQL ──────────────────────────────────────
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=ai_job_hunter
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── n8n ─────────────────────────────────────────────
N8N_ENCRYPTION_KEY=changeme_generate_with_openssl_rand_hex_32
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_admin_password
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# ── OpenRouter ───────────────────────────────────────
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Free models: openrouter/free | google/gemma-4-31b-it:free
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Telegram (Optional for phone notifications) ─────
# Create bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Email Auto-Apply SMTP (Optional for automated emails) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=your_email@gmail.com

# ── Application Settings ─────────────────────────────
MAX_AI_REQUESTS_PER_DAY=50
MIN_MATCH_SCORE=70
PREFERRED_MATCH_SCORE=80
JOB_DESCRIPTION_MAX_CHARS=6000
ENABLE_MOCK_MODE=false

# ── Dashboard & Security ─────────────────────────────
DASHBOARD_PORT=3000
DASHBOARD_SECRET=changeme_dashboard_secret
DASHBOARD_PASSCODE=Ghaith_Master_Key_2026!

# ── Timezone ─────────────────────────────────────────
TZ=Africa/Tunis
